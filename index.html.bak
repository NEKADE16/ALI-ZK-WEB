<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>ALI ZK Code | الرئيسية</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Cairo', sans-serif;
            min-height: 100vh;
            background: linear-gradient(135deg, #0a0a2a 0%, #1a1a3e 50%, #0a0a2a 100%);
            color: white;
            overflow-x: hidden;
        }
        /* خلفية متحركة */
        .matrix-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -2;
            background: linear-gradient(135deg, #0a0a2a 0%, #1a1a3e 50%, #0a0a2a 100%);
        }
        canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            opacity: 0.15;
        }
        /* شريط التنقل */
        .navbar {
            background: rgba(10, 10, 30, 0.95);
            backdrop-filter: blur(15px);
            padding: 1rem 2rem;
            position: fixed;
            width: 100%;
            top: 0;
            z-index: 100;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
        }
        .logo {
            font-size: 1.5rem;
            font-weight: 800;
        }
        .logo i { color: #00cec9; }
        .logo span { color: #00cec9; }
        .nav-links {
            display: flex;
            gap: 1.5rem;
            flex-wrap: wrap;
        }
        .nav-links a {
            color: white;
            text-decoration: none;
            transition: 0.3s;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .nav-links a:hover { color: #00cec9; transform: translateY(-2px); }
        .menu-toggle { display: none; font-size: 1.5rem; cursor: pointer; }
        /* المحتوى الرئيسي */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 100px 20px 60px;
        }
        /* القسم الرئيسي */
        .hero {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 3rem;
            align-items: center;
            margin-bottom: 60px;
        }
        .hero-text h1 {
            font-size: 3rem;
            margin-bottom: 1rem;
        }
        .hero-text h1 span { color: #00cec9; }
        .hero-text p { color: #cbd5e1; margin-bottom: 1.5rem; }
        .code-animation {
            background: rgba(0,0,0,0.5);
            padding: 1.5rem;
            border-radius: 20px;
            font-family: monospace;
        }
        .code-line { margin: 8px 0; opacity: 0; animation: fadeUp 0.5s forwards; }
        .code-line:nth-child(1) { animation-delay: 0.2s; }
        .code-line:nth-child(2) { animation-delay: 0.5s; }
        .code-line:nth-child(3) { animation-delay: 0.8s; }
        .code-line:nth-child(4) { animation-delay: 1.1s; }
        .code-line:nth-child(5) { animation-delay: 1.4s; }
        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .btn {
            padding: 12px 28px;
            border: none;
            border-radius: 40px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.3s;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
        }
        .btn-primary {
            background: linear-gradient(135deg, #6c5ce7, #a855f7);
            color: white;
        }
        .btn-primary:hover { transform: translateY(-3px); box-shadow: 0 10px 25px rgba(108,92,231,0.4); }
        .btn-outline {
            background: transparent;
            border: 2px solid #6c5ce7;
            color: white;
        }
        .btn-outline:hover { background: rgba(108,92,231,0.2); transform: translateY(-3px); }
        /* المميزات */
        .section-title {
            text-align: center;
            font-size: 2rem;
            margin: 60px 0 40px;
        }
        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 1.5rem;
        }
        .feature-card {
            background: rgba(255,255,255,0.08);
            backdrop-filter: blur(10px);
            padding: 1.5rem;
            border-radius: 20px;
            text-align: center;
            transition: 0.3s;
            border: 1px solid rgba(255,255,255,0.1);
        }
        .feature-card:hover { transform: translateY(-5px); background: rgba(108,92,231,0.2); }
        .feature-icon { font-size: 2.5rem; color: #00cec9; margin-bottom: 1rem; }
        /* عن المطور */
        .about {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 3rem;
            align-items: center;
            margin: 60px 0;
            background: rgba(255,255,255,0.05);
            border-radius: 30px;
            padding: 2rem;
        }
        .skills { display: flex; flex-wrap: wrap; gap: 10px; margin: 20px 0; }
        .skills span {
            background: rgba(108,92,231,0.3);
            padding: 5px 15px;
            border-radius: 20px;
        }
        .social-links { display: flex; gap: 1rem; margin-top: 20px; }
        .social-links a { color: white; font-size: 1.5rem; transition: 0.3s; }
        .social-links a:hover { color: #00cec9; transform: translateY(-3px); }
        /* الفوتر */
        footer {
            text-align: center;
            padding: 2rem;
            background: rgba(0,0,0,0.5);
            margin-top: 40px;
        }
        /* استجابة للجوال */
        @media (max-width: 768px) {
            .navbar { padding: 1rem; }
            .nav-links {
                display: none;
                width: 100%;
                flex-direction: column;
                text-align: center;
                padding: 1rem 0;
            }
            .nav-links.active { display: flex; }
            .menu-toggle { display: block; }
            .hero { grid-template-columns: 1fr; text-align: center; }
            .about { grid-template-columns: 1fr; text-align: center; }
            .hero-text h1 { font-size: 2rem; }
        }
    </style>
</head>
<body>
    <div class="matrix-bg"></div>
    <canvas id="matrixCanvas"></canvas>

    <nav class="navbar">
        <div class="logo">
            <i class="fas fa-code"></i> ALI ZK <span>code</span>
        </div>
        <div class="menu-toggle"><i class="fas fa-bars"></i></div>
